# ==============================================================================
# BONHAGAN TRANSIT — Comprehensive .gitignore
# Prevents secrets, environment configurations, logs, and sensitive data
# from being committed to GitHub or any public version control repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & SECRET CONFIGURATION FILES (CRITICAL)
# ------------------------------------------------------------------------------
# Never commit real credentials, database passwords, or API keys
.env
.env.*
*.env
**/.env
**/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example / template environment files only
!.env.example
!**/.env.example
!.env.template
!**/.env.template

# ------------------------------------------------------------------------------
# 2. LOCAL CONFIGURATIONS & PRIVATE SECRETS
# ------------------------------------------------------------------------------
config.local.php
database.local.php
local.config.php
local_settings.php
connect_local.php
secrets.php
secrets.json
auth_secrets.*
credentials.json
service-account*.json
client_secret*.json
google-services.json
*firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# 3. PRIVATE KEYS, CERTIFICATES & TOKENS
# ------------------------------------------------------------------------------
*.pem
*.key
*.pub
*.crt
*.cer
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
id_ed25519*
*.id_rsa
*.id_ed25519

# ------------------------------------------------------------------------------
# 4. DATABASE BACKUPS, DUMPS & RAW DATA
# ------------------------------------------------------------------------------
*.dump
*.backup
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.sql.tar
*dump*.sql
backup*.sql
db_backup/
database_backups/

# Keep repository schema and initial seeder files
!database/schema.sql
!database/seed.sql

# ------------------------------------------------------------------------------
# 5. LOGS, CACHE & TEMPORARY FILES
# ------------------------------------------------------------------------------
*.log
error_log
access_log
debug.log
debug.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary test & debug scratch scripts
tests/debug_*.php

# Temporary folders & sessions
tmp/
temp/
sessions/
.cache/
.phpunit.result.cache

# ------------------------------------------------------------------------------
# 6. DEPENDENCY DIRECTORIES
# ------------------------------------------------------------------------------
vendor/
node_modules/
bower_components/
composer.phar

# ------------------------------------------------------------------------------
# 7. OS METADATA & ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*~

# ------------------------------------------------------------------------------
# 8. IDE & EDITOR SETTINGS
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-*
.history/

# Allow team workspace recommendations in .vscode while ignoring local overrides
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
